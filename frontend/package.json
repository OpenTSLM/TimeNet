{
  "name": "timenet-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run format:check && tsc --noEmit && vite build",
    "test": "playwright test",
    "contract": "openapi-typescript schema.json -o src/generated/api.d.ts --default-non-nullable false",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/*.js\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/*.js\" \"*.js\""
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi-typescript": "^7.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
