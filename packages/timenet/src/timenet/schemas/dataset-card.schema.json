{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.timenet.ai/schemas/dataset-card-v1.schema.json",
  "$defs": {
    "Access": {
      "description": "How a user obtains the source data.",
      "enum": [
        "open",
        "credentialed",
        "restricted"
      ],
      "title": "Access",
      "type": "string"
    },
    "DatasetRef": {
      "additionalProperties": false,
      "description": "An exact release, independent of its registry location.",
      "properties": {
        "dataset_id": {
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*/[A-Za-z0-9_-][A-Za-z0-9._-]*$",
          "title": "Dataset Id",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "version"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "Domain": {
      "description": "Describes what kind of data a dataset contains. A dataset may declare more than one.",
      "enum": [
        "health",
        "cardiology",
        "respiratory",
        "sleep",
        "activity",
        "motion",
        "economics",
        "finance",
        "environment",
        "energy",
        "transport",
        "observability",
        "audio",
        "industrial",
        "general"
      ],
      "title": "Domain",
      "type": "string"
    },
    "License": {
      "description": "The legal license of the source data. Values are SPDX-style identifiers.",
      "enum": [
        "MIT",
        "Apache-2.0",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "GPL-3.0",
        "LGPL-3.0",
        "MPL-2.0",
        "CC0-1.0",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "CC-BY-NC-4.0",
        "ODC-By-1.0",
        "ODbL-1.0",
        "OTHER",
        "NONE"
      ],
      "title": "License",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Dataset identity, release version, source information, and access requirements.\n\nThe dataset card defines these fields. ``dataset_version`` identifies the TimeNet release.\n``source_revision`` identifies the original source release, tag, or commit.\n``yaml_schema_version`` identifies the card schema. ``dataset_id`` is a case-sensitive\n``org/name`` pair with exactly one slash. Casing-only differences can cause conflicts on\ncase-insensitive filesystems.",
  "properties": {
    "dataset_id": {
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*/[A-Za-z0-9_-][A-Za-z0-9._-]*$",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "inputs": {
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/DatasetRef"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Inputs",
      "type": "object"
    },
    "source_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Revision"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "license": {
      "$ref": "#/$defs/License"
    },
    "domains": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Domain"
      },
      "title": "Domains",
      "type": "array"
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "license_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License Url"
    },
    "citation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Citation"
    },
    "access": {
      "$ref": "#/$defs/Access",
      "default": "open"
    },
    "access_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Access Url"
    },
    "yaml_schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Yaml Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "name",
    "description",
    "license"
  ],
  "title": "DatasetMetadata",
  "type": "object"
}
