{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.timenet.ai/schemas/dataset-card-v2.schema.json",
  "title": "TimeNet Dataset Card",
  "description": "Human-authored metadata for a TimeNet dataset: the card YAML that sits beside a connector and is the single source for the dataset's descriptive identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "dataset_version", "name", "description", "license"],
  "properties": {
    "yaml_schema_version": {
      "type": "integer",
      "const": 2,
      "description": "The card's own field-schema version."
    },
    "dataset_id": { "$ref": "#/$defs/datasetId" },
    "dataset_version": { "$ref": "#/$defs/semver" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "license": { "$ref": "#/$defs/license" },
    "domains": { "type": "array", "items": { "$ref": "#/$defs/domain" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source_url": { "type": ["string", "null"] },
    "source_revision": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Optional upstream release or revision; independent of the TimeNet dataset version."
    },
    "license_url": { "type": ["string", "null"] },
    "citation": { "type": ["string", "null"] },
    "access": { "$ref": "#/$defs/access" },
    "access_url": { "type": ["string", "null"] },
    "parents": {
      "type": "array",
      "items": { "$ref": "#/$defs/parent" },
      "description": "Exact parent versions exposed to the connector under stable aliases."
    }
  },
  "$defs": {
    "datasetId": {
      "type": "string",
      "pattern": "^(?!\\.)[A-Za-z0-9._-]+/(?!\\.)[A-Za-z0-9._-]+$",
      "description": "HuggingFace-style org/name: exactly one slash, and no segment may start with '.'."
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "major.minor.patch with non-negative integer components."
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "dataset_id", "version"],
      "properties": {
        "alias": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "dataset_id": { "$ref": "#/$defs/datasetId" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "license": {
      "type": "string",
      "description": "SPDX-style license identifier. Kept in sync with timenet.types.License by a drift test.",
      "enum": [
        "MIT",
        "Apache-2.0",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "GPL-3.0",
        "LGPL-3.0",
        "MPL-2.0",
        "CC0-1.0",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "CC-BY-NC-4.0",
        "ODC-By-1.0",
        "ODbL-1.0",
        "other"
      ]
    },
    "domain": {
      "type": "string",
      "description": "Kept in sync with timenet.types.Domain by a drift test.",
      "enum": [
        "health",
        "cardiology",
        "respiratory",
        "sleep",
        "activity",
        "motion",
        "economics",
        "finance",
        "environment",
        "energy",
        "transport",
        "observability",
        "audio",
        "general"
      ]
    },
    "access": {
      "type": "string",
      "description": "Kept in sync with timenet.types.Access by a drift test.",
      "enum": ["open", "credentialed", "restricted"]
    }
  }
}
